# ── Simantrix Dashboard — Environment Variables ──────────────────────────────

# Port the dashboard runs on
PORT=4100

# Backend API URL (internal — used by the BFF proxy, never exposed to browser)
INTERNAL_BACKEND_URL=http://localhost:5000

# Shared gateway secret for BFF ↔ Backend authentication
GATEWAY_SECRET=replace-with-a-long-random-secret-shared-by-backend-and-bffs

# Public API URL exposed to the browser (proxied through the BFF)
NEXT_PUBLIC_API_URL=/api/v1

# Public website (Simantrix-home). "Sign in again" on /auth/callback links to <url>/sign-in
NEXT_PUBLIC_HOME_URL=http://localhost:4000

# Razorpay public key ID for checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Docker override notes ────────────────────────────────────────────────────
# When running inside Docker Compose, INTERNAL_BACKEND_URL should point to the
# backend container name (e.g. http://backend:5000). This is handled
# automatically by the docker-compose.yml environment block.
